<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.22.0</Version>
    <Deterministic>true</Deterministic>
    <IncludeHttpSearchService Condition="'$(IncludeHttpSearchService)' == ''">true</IncludeHttpSearchService>
    <DefineConstants Condition="'$(IncludeHttpSearchService)' == 'true'">$(DefineConstants);HTTP_SEARCH_SERVICE</DefineConstants>
  </PropertyGroup>
</Project>
